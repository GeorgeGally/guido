{
  "manifest_version": 3,
  "name": "Ruler",
  "version": "1.1.0",
  "description": "Rulers and guides for any web page.",
  "icons": {
    "16": "icons/ruler-16.png",
    "32": "icons/ruler-32.png",
    "48": "icons/ruler-48.png",
    "128": "icons/ruler-128.png"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Ruler",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/ruler-16.png", "32": "icons/ruler-32.png" }
  },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }],
  "commands": {
    "toggle-overlay": { "suggested_key": { "default": "Alt+R" }, "description": "Toggle rulers and guides" },
    "toggle-guides": { "suggested_key": { "default": "Alt+Shift+R" }, "description": "Show or hide guides" },
    "clear-guides": { "suggested_key": { "default": "Alt+Shift+C" }, "description": "Clear all guides" },
    "mirror-last": { "suggested_key": { "default": "Alt+Shift+M" }, "description": "Mirror the last guide" }
  }
}
